# Copy to .env and fill in the secrets
# Generate JWT_SECRET with: openssl rand -hex 32

DATABASE_URL=postgresql+asyncpg://mipay:changeme@postgres:5432/mipay
POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme-replace-with-openssl-rand-hex-32

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

OLLAMA_URL=http://ollama:11434
EXTRACTION_MODEL=qwen2.5:7b-instruct

MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=5242880
